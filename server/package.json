{
  "name": "pi-remote-server",
  "version": "0.1.0",
  "description": "Standalone multi-session server for pi coding agent",
  "homepage": "https://github.com/wighawag/pi-remote#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wighawag/pi-remote.git",
    "directory": "server"
  },
  "bugs": {
    "url": "https://github.com/wighawag/pi-remote/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
