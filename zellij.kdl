layout {
	pane split_direction="vertical" {
		
	}
	pane split_direction="vertical" {
		pane name="web" command="pnpm"  {
			args "web:dev"
		}
		pane name="svelte-check" command="pnpm"  {
			args "--filter" "./web" "check:watch"
		}
	}

	pane split_direction="vertical" {
		// pane name="extension" command="pnpm"  {
		// 	args "--filter" "./extension" "dev"
		// }
		pane name="extension" command="pi"  {
			args "--extension" "./extension/dist/index.js" "--remote-port" "8765" 
		}
	}
}
