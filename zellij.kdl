layout {
	pane split_direction="vertical" {

	}
	pane split_direction="vertical" {
		pane name="web" command="pnpm"  {
			args "web:dev"
		}
		pane name="svelte-check" command="pnpm"  {
			args "--filter" "./web" "check:watch"
		}
	}

	pane split_direction="vertical" {
		pane name="server" command="pnpm"  {
			args "server:dev" "--host" "0.0.0.0"
		}
	}
}
