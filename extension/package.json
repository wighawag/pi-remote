{
  "name": "pi-remote",
  "version": "0.0.3",
  "description": "Remote control extension for pi coding agent with HTTP/WebSocket API",
  "homepage": "https://github.com/wighawag/pi-remote#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wighawag/pi-remote.git",
    "directory": "extension"
  },
  "bugs": {
    "url": "https://github.com/wighawag/pi-remote/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "remote",
    "websocket",
    "http"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.75.3",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "client": "tsx src/client.ts",
    "start": "node dist/index.js"
  }
}
